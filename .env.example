# Copy to .env.local for local development, and add the same variables in
# your hosting provider's project settings. Never commit real values.

# Final public URL once the domain is connected, e.g. https://www.example.lk
# Enables canonical URLs, absolute social-sharing URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Optional: HTTPS endpoint that receives enquiries as JSON (e.g. a Make,
# Zapier or Formspree webhook, or your own API). Server-side only.
# Leave empty to use the WhatsApp handoff configured in src/config/site.ts.
ENQUIRY_WEBHOOK_URL=

# Optional: shared secret sent as "Authorization: Bearer <secret>" to the webhook.
ENQUIRY_WEBHOOK_SECRET=
