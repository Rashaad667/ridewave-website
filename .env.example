# Copy to .env.local for local development, and add the same variables in
# your hosting provider's settings (Netlify: Site configuration → Environment
# variables), then redeploy. Never commit real values.

# Final public URL once the domain is connected, e.g. https://www.example.lk
# Enables canonical URLs, absolute social-sharing URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Optional: public form endpoint that receives enquiries, e.g. a Formspree
# form URL (https://formspree.io/f/xxxxxxx). Must be https. Leave empty to use
# the WhatsApp handoff configured in src/config/site.ts.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
